{
  "name": "@lorcana/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "browser"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 0.0.0.0",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort"
  },
  "dependencies": {
    "@lorcana/contracts": "workspace:*",
    "@lorcana/presentation": "workspace:*",
    "@lorcana/design-system": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.2",
    "@playwright/test": "1.63.0"
  }
}
