{
  "name": "@lorcana/match-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --conditions=lorcana-source --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "node --test --test-concurrency=1 tests/unit.test.mjs tests/cache.test.mjs tests/references.test.mjs tests/clocks.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.mjs tests/transport-store.test.mjs tests/gateway.test.mjs tests/live-client.test.mjs tests/clock-storage.test.mjs tests/clock-service.test.mjs tests/clock-process.test.mjs tests/clock-live.test.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.3",
    "@lorcana/contracts": "workspace:*",
    "@lorcana/db": "workspace:*",
    "@lorcana/engine-adapter": "workspace:*",
    "@lorcana/service-runtime": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "pg": "8.23.1",
    "ws": "8.22.0"
  }
}
