{
  "name": "lorcana-online-tcg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible workspace foundation for the Lorcana online game.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "db:check": "node scripts/db-check.mjs",
    "dev:smoke": "node scripts/serve-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm boundaries && pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --filter './packages/**' --workspace-concurrency=1 build && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint . && pnpm boundaries",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm build && pnpm test:bootstrap && pnpm -r --workspace-concurrency=1 test && node --test tests/foundation/*.test.mjs",
    "test:e2e:smoke": "pnpm --filter @lorcana/web test:e2e",
    "verify:foundation": "pnpm verify && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "parse5": "8.0.0",
    "postcss-value-parser": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
