{
  "name": "@lorcana/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=lorcana-source --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "typebox": "1.3.35"
  },
  "devDependencies": {},
  "exports": {
    ".": {
      "lorcana-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clocks": {
      "lorcana-source": "./src/clocks.ts",
      "types": "./dist/clocks.d.ts",
      "default": "./dist/clocks.js"
    },
    "./player-moves": {
      "lorcana-source": "./src/player-moves.ts",
      "types": "./dist/player-moves.d.ts",
      "default": "./dist/player-moves.js"
    }
  }
}
