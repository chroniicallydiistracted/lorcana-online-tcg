{
  "name": "@lorcana/rules-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=lorcana-source --test --test-concurrency=1 tests/*.test.mjs",
    "catalog:verify": "node scripts/verify-fixtures.mjs docs/rules/2026-10-21-ravensburger-catalog.json"
  },
  "dependencies": {},
  "devDependencies": {},
  "exports": {
    ".": {
      "lorcana-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "lorcana-source": "./src/fixtures.ts",
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    }
  }
}
