{
  "name": "@lorcana/engine-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@lorcana/contracts": "workspace:*",
    "@lorcana/vendor-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
