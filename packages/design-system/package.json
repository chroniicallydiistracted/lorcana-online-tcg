{
  "name": "@lorcana/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "browser"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open --ci",
    "build-storybook": "storybook build --output-dir ../../.local/design-system-storybook --quiet",
    "test:browser": "node scripts/browser-tests.mjs"
  },
  "dependencies": {
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "style-dictionary": "5.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "exports": {
    ".": {
      "lorcana-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "lorcana-source": "./src/generated/renderer.ts",
      "types": "./dist/generated/renderer.d.ts",
      "default": "./dist/generated/renderer.js"
    }
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
