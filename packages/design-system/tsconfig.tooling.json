{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true
  },
  "include": [
    "src",
    "stories",
    ".storybook",
    "tests/browser",
    "playwright.config.ts"
  ]
}
