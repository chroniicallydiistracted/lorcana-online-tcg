  "focus": {
    "width": {
      "$type": "dimension",
      "$value": "{border-width.2}",
      "$description": "Focus boundary width, about 2 px (§25)."
    },
    "offset": {
      "$type": "dimension",
      "$value": "{size.focus-offset}",
      "$description": "Focus boundary offset, 3 px (§25)."
    }
  },
  "density": {
    "$description": "Density rows (standard §11). Compact density never reduces body text.",
    "row": {
      "comfortable": {
        "$type": "dimension",
        "$value": "{size.row-comfortable}",
        "$description": "Comfortable row, about 56 px."
      },
      "compact": {
        "$type": "dimension",
        "$value": "{size.row-compact}",
        "$description": "Compact row, about 44 px."
      }
    }
  },
  "layout": {
    "gutter": {
      "compact": {
        "$type": "dimension",
        "$value": "{size.gutter-compact}",
        "$description": "Compact page gutter."
      },
      "intermediate": {
        "$type": "dimension",
        "$value": "{size.gutter-intermediate}",
        "$description": "Intermediate page gutter."
      },
      "wide": {
        "$type": "dimension",
        "$value": "{size.gutter-wide}",
        "$description": "Wide page gutter."
      }
    },
    "content-max": {
      "$type": "dimension",
      "$value": "{size.content-max}",
      "$description": "Standard content width cap, about 90rem."
    },
    "reading-measure": {
      "$type": "number",
      "$value": 75,
      "$description": "Reading column upper bound in characters (standard: approximately 60-75).",
      "$extensions": {
        "org.theinkspire": {
          "cssUnit": "ch"
        }
      }
    }
  },
  "motion": {
    "$description": "Motion roles (standard §26). Reduced motion resolves to immediate or a brief fade.",
    "hover": {
      "$type": "duration",
      "$value": "{motion.duration.80}",
      "$description": "Hover/pressed styling (80-120 ms)."
    },
    "menu": {
      "$type": "duration",
      "$value": "{motion.duration.120}",
      "$description": "Menu/popover (120-180 ms)."
    },
    "dialog": {
      "$type": "duration",
      "$value": "{motion.duration.180}",
      "$description": "Dialog/sheet (180-240 ms)."
    },
    "binder-page": {
      "$type": "duration",
      "$value": "{motion.duration.240}",
      "$description": "Binder page change (about 240 ms)."
    },
    "card": {
      "$type": "duration",
      "$value": "{motion.duration.180}",
      "$description": "Ordinary card movement (180-360 ms)."
    },
    "major": {
      "$type": "duration",
      "$value": "{motion.duration.360}",
      "$description": "Major match event (360-600 ms)."
    },
    "reward-beat-max": {
      "$type": "duration",
      "$value": "{motion.duration.900}",
      "$description": "Maximum per authored pack/reward beat (about 900 ms)."
    },
    "fade": {
      "$type": "duration",
      "$value": "{motion.duration.120}",
      "$description": "Brief fade used by reduced-motion treatments."
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.productive}",
      "$description": "Productive easing."
    },
    "ease-exit": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.exit}",
      "$description": "Exit easing."
    }
  }
