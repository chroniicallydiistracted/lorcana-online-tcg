{
  "color": {
    "$type": "color",
    "identity": {
      "$description": "Ink identities (standard §9): each is always paired with its name or an equivalent non-colour cue.",
      "amber": {
        "$value": "{color.ink.amber}",
        "$description": "Amber ink identity."
      },
      "amethyst": {
        "$value": "{color.ink.amethyst}",
        "$description": "Amethyst ink identity."
      },
      "emerald": {
        "$value": "{color.ink.emerald}",
        "$description": "Emerald ink identity."
      },
      "ruby": {
        "$value": "{color.ink.ruby}",
        "$description": "Ruby ink identity."
      },
      "sapphire": {
        "$value": "{color.ink.sapphire}",
        "$description": "Sapphire ink identity."
      },
      "steel": {
        "$value": "{color.ink.steel}",
        "$description": "Steel ink identity."
      }
    }
  },
  "typography": {
    "$description": "Interface type roles (standard §6). Essential instructions never use the annotation role.",
    "annotation": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.interface}",
        "fontSize": "{font.size.12}",
        "lineHeight": "{font.line-height.16}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Small annotation: nonessential supplementary information."
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.interface}",
        "fontSize": "{font.size.14}",
        "lineHeight": "{font.line-height.20}",
