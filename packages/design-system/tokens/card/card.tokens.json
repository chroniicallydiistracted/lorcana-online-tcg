      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.card-title}",
        "$description": "Title family."
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Title weight."
      },
      "size": {
        "$type": "number",
        "$value": 5,
        "$description": "Title size relative to the card face.",
        "$extensions": {
          "org.theinkspire": {
            "cssUnit": "cqw"
          }
        }
      }
    },
    "version": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.card-text}",
        "$description": "Version/subtitle family."
