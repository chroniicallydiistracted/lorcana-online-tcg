{
  "component": {
    "$description": "Component contracts (standard §13). Components consume semantic or component tokens only.",
    "control": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.4}",
        "$description": "Control corner radius."
      },
      "min-size": {
        "$type": "dimension",
        "$value": "{size.target-min}",
        "$description": "Minimum hit area for controls."
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.4}",
        "$description": "Inline padding of text controls."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.2}",
        "$description": "Gap between an icon and its label inside a control."
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{border-width.1}",
        "$description": "Control border width."
      },
      "compact-input": {
        "$type": "dimension",
        "$value": "{size.target-min}",
        "$description": "Number input width of a compact stepper, such as a deck line's quantity."
      }
    },
    "surface": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.8}",
        "$description": "Contained surface radius."
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.4}",
        "$description": "Contained surface padding."
      }
    },
    "field": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.2}",
        "$description": "Label to field spacing."
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.8}",
        "$description": "Dialog radius."
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.6}",
        "$description": "Dialog padding."
      },
      "inline-size": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "rem"
        },
        "$description": "Default dialog width."
      }
    },
    "sheet": {
      "inline-size": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "rem"
        },
        "$description": "Side sheet width in wide layouts."
      }
    },
    "popover": {
      "padding": {
        "$type": "dimension",
        "$value": "{space.2}",
        "$description": "Popover padding."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.8}",
        "$description": "Popover radius."
      }
    },
    "tooltip": {
      "max-inline-size": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "rem"
        },
        "$description": "Tooltip width cap."
      }
    },
    "inspector": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.6}",
        "$description": "Gap between inspector sections."
      },
      "reading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.card-text}",
          "fontSize": "{font.size.20}",
          "lineHeight": "{font.line-height.28}",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        },
        "$description": "Inspector reading presentation: rules text at 20/28 px (§7)."
      }
    },
    "binder": {
      "pocket": {
        "$type": "dimension",
        "$value": "{size.binder-pocket}",
        "$description": "Preferred pocket width."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{size.binder-gap}",
        "$description": "Pocket gap."
      },
      "face-padding": {
        "$type": "dimension",
        "$value": "{size.binder-face-padding}",
        "$description": "Face padding."
      },
      "pocket-min": {
        "$type": "dimension",
        "$value": {
          "value": 7,
          "unit": "rem"
        },
        "$description": "Minimum usable pocket width (112 px) before a spread drops to a single face (§17)."
      },
      "go-to": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "rem"
        },
        "$description": "Width of the Go to card number field."
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.4}",
        "$description": "Badge radius."
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.2}",
        "$description": "Badge inline padding."
      }
    },
    "icon": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "Standard interface icon size for controls: 20 px at the default root (decision D21)."
      },
      "size-prominent": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Prominent navigation icon size: 24 px at the default root (decision D21)."
      }
    },
    "selection": {
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Checkbox and radio box size and switch track height: 24 px at the default root, inside the 44 px target."
      }
    },
    "ink": {
      "symbol-size": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "Ink identity symbol inside the ink chip: 20 px at the default root, the standard icon size, so the official badge keeps its detail."
      }
    },
    "avatar": {
      "size": {
        "$type": "dimension",
        "$value": "{space.8}",
        "$description": "Neutral initials avatar diameter: 32 px at the default root (§24)."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.pill}",
        "$description": "Avatar shape: a circle, the identity treatment the standard allows pills for (§12)."
      }
    },
    "room": {
      "ink-gutter": {
        "$type": "dimension",
        "$value": "{space.16}",
        "$description": "Perimeter gutter reserved for ink-form artwork on each side of a room at expanded widths (§4, decision D27)."
      }
    },
    "catalog": {
      "tile-min": {
        "$type": "dimension",
        "$value": {
          "value": 9.5,
          "unit": "rem"
        },
        "$description": "Minimum catalog card column in the deckbuilder grid: 152 px, about four columns beside the deck region at tablet landscape."
      },
      "search-min": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "rem"
        },
        "$description": "Minimum width of the catalog search field before its row wraps."
      },
      "select-min": {
        "$type": "dimension",
        "$value": {
          "value": 9.5,
          "unit": "rem"
        },
        "$description": "Minimum width of each catalog filter select, so the five fit one row in the 824 px catalog column at 1440 px."
      }
    },
    "deckbuilder": {
      "deck": {
        "$type": "dimension",
        "$value": {
          "value": 25,
          "unit": "rem"
        },
        "$description": "Deck region width at expanded layouts (80 rem and above)."
      },
      "deck-narrow": {
        "$type": "dimension",
        "$value": {
          "value": 22.5,
          "unit": "rem"
        },
        "$description": "Deck region width from 64 to 80 rem, such as tablet landscape: wide enough that a deck line keeps whole words beside its stepper, leaving four catalog columns."
      }
    },
    "chart": {
      "plot-block-size": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "rem"
        },
        "$description": "Plot height of compact in-panel charts such as the cost curve, value labels included."
      },
      "bar-max": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "Maximum column thickness: 24 px, so a column never fills its band."
      },
      "bar-radius": {
        "$type": "dimension",
        "$value": "{radius.4}",
        "$description": "Rounded data end of a column; the baseline end stays square."
      }
    },
    "pack": {
      "product": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "rem"
        },
        "$description": "Width of a product to open, with its artwork slot."
      },
      "perspective": {
        "$type": "dimension",
        "$value": {
          "value": 60,
          "unit": "rem"
        },
        "$description": "Perspective distance for the card turn during a reveal: shallow, so the turn reads as card stock rather than a spin."
      },
      "summary-item": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "rem"
        },
        "$description": "Minimum column of the opening summary."
      },
      "summary-card": {
        "$type": "dimension",
        "$value": {
          "value": 5,
          "unit": "rem"
        },
        "$description": "Card width in the opening summary."
      },
      "reveal-max": {
        "$type": "dimension",
        "$value": {
          "value": 66,
          "unit": "rem"
        },
        "$description": "Maximum width of the reveal stage, so two rows of six cards and the controls fit a 900 px tall desktop viewport."
      }
    }
  }
}
