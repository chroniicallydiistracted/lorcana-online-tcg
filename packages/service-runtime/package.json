{
  "name": "@lorcana/service-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "lorcana": {
    "scope": "server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=lorcana-source --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lorcana/contracts": "workspace:*",
    "fastify": "5.12.5",
    "@fastify/type-provider-typebox": "6.1.0",
    "typebox": "1.3.35"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  },
  "exports": {
    ".": {
      "lorcana-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lifecycle": {
      "lorcana-source": "./src/lifecycle.ts",
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    }
  }
}
