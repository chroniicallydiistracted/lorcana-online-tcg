{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string",
      "format": "utc-timestamp"
    },
    "change_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "change_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "draft",
          "finalized",
          "interrupted",
          "blocked"
        ]
      }
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "name",
          "line",
          "column",
          "kind",
          "signature"
        ]
      }
    },
    "documentation_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "current",
              "planning",
              "historical",
              "archive",
              "reserved",
              "generated",
              "evidence",
              "history"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "classification",
          "sources"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "observed_at",
    "change_ids",
    "change_statuses",
    "source_fingerprint",
    "files",
    "functions",
    "documentation_map"
  ]
}
