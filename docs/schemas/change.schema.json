{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "change",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{8}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "finalized",
        "interrupted",
        "blocked"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "utc-timestamp"
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc-timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_time_basis": {
      "enum": [
        "git_commit",
        "execution",
        "recorded_only"
      ]
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "feature_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "implementation",
              "expansion",
              "function",
              "feature",
              "test",
              "edit",
              "revision",
              "documentation",
              "fix",
              "removal",
              "review"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "description"
        ]
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documentation_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "updated",
              "reviewed_unchanged",
              "historical_preserved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "disposition",
          "reason"
        ]
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "historical",
              "not_run",
              "pending",
              "reported"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence",
          "outcome",
          "scope"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "actor",
    "status",
    "recorded_at",
    "occurred_at",
    "event_time_basis",
    "source_commit",
    "task_ids",
    "requirement_ids",
    "feature_ids",
    "changes",
    "files",
    "documentation_reviews",
    "verification",
    "limitations",
    "next_actions"
  ]
}
