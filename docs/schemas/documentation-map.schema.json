{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "documentation-map",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "current",
              "planning",
              "historical",
              "archive",
              "reserved",
              "generated",
              "evidence",
              "history"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "path",
          "classification",
          "sources"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "documents"
  ]
}
